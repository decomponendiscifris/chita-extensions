{
  "issued": "2026-11-05T20:09:59Z",
  "extensions": [
    {
      "id": "it.urial.chita.git",
      "name": "Git",
      "version": "0.1.1",
      "author": "Chita",
      "description": "Shows what changed in a repository: a Git column with each item's state, a panel with the branch, what's ahead or behind and the last commit, and commands to stage, unstage, commit, fetch, pull, push, and see changes and history. Runs the git on this Mac in the folder you're viewing, with the repository's own remotes.",
      "categories": [
        "Developer Tools"
      ],
      "risk": "high",
      "permissions": [
        "folder",
        "tool:git"
      ],
      "api": 1,
      "url": "https://github.com/decomponendiscifris/chita-extensions/releases/download/it.urial.chita.git-0.1.1/it.urial.chita.git-0.1.1.chitaext",
      "sha256": "3348f8633921d761595278b12725b482e45843eb3a40da8a1ab7e14e3552d5f7",
      "size": 63446,
      "published": "2026-11-05T20:09:59Z",
      "repository": "https://github.com/decomponendiscifris/chita-extensions/tree/main/extensions/it.urial.chita.git",
      "commands": [
        {
          "id": "stage",
          "title": "Stage",
          "description": "Adds the selected items to the next commit.",
          "when": "selection"
        },
        {
          "id": "unstage",
          "title": "Unstage",
          "description": "Takes the selected items out of the next commit.",
          "when": "selection"
        },
        {
          "id": "commit",
          "title": "Commit…",
          "description": "Commits what’s staged, asking for the message.",
          "when": "folder"
        },
        {
          "id": "changes",
          "title": "Show Changes",
          "description": "Shows the diff of what changed since the last commit.",
          "when": "folder"
        },
        {
          "id": "history",
          "title": "Show History",
          "description": "Shows the last commits of the repository.",
          "when": "folder"
        },
        {
          "id": "fetch",
          "title": "Fetch",
          "description": "Fetches from the configured upstream.",
          "when": "folder"
        },
        {
          "id": "pull",
          "title": "Pull",
          "description": "Pulls from the configured upstream.",
          "when": "folder"
        },
        {
          "id": "push",
          "title": "Push",
          "description": "Pushes to the configured upstream.",
          "when": "folder"
        }
      ],
      "columns": [
        "Git"
      ],
      "panels": [
        "Git"
      ],
