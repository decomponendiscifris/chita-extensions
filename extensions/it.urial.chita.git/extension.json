{
  "id": "it.urial.chita.git",
  "name": "Git",
  "version": "0.7.0",
  "author": "Chita",
  "description": "A repository as a place in Chita: a header with the branch and what changed, Changes with staging, conflicts and stashes, Branches and tags with checkout, merge, rebase and delete, History with the commit graph, Worktrees and submodules, Flow with feature, release and hotfix branches and the commit convention, the diff of what you select in the Inspector, a Git column, and commands to commit, fetch, pull, push, clone and keep .gitignore. Runs the git on this Mac in the folder you're viewing, with the repository's own remotes.",
  "module": "chita_git.wasm",
  "categories": [
    "Developer Tools"
  ],
  "permissions": {
    "files": [
      {
        "path": "folder",
        "write": true
      }
    ],
    "tools": [
      "git"
    ]
  },
  "contributes": {
    "contexts": [
      {
        "id": "repository",
        "title": "Git repository",
        "symbol": "arrow.triangle.branch",
        "tint": "red",
        "marker": ".git",
        "on_move": "track-moves",
        "screens": [
          {
            "id": "changes",
            "title": "Changes",
            "symbol": "pencil.line"
          },
          {
            "id": "branches",
            "title": "Branches",
            "symbol": "arrow.triangle.branch"
          },
          {
            "id": "history",
            "title": "History",
            "symbol": "clock"
          },
          {
            "id": "worktrees",
            "title": "Worktrees",
            "symbol": "square.on.square"
          },
          {
            "id": "flow",
            "title": "Flow",
            "symbol": "point.3.connected.trianglepath.dotted"
          },
          {
            "id": "file",
            "title": "File",
            "symbol": "doc.text.magnifyingglass"
          }
        ]
      }
    ],
    "commands": [
      {
        "id": "stage",
        "title": "Stage",
        "description": "Adds the selected items to the next commit.",
        "when": "selection",
        "symbol": "plus.circle",
        "place": "context",
        "menu": "items",
        "group": "Staging"
      },
      {
        "id": "unstage",
        "title": "Unstage",
        "description": "Takes the selected items out of the next commit.",
        "when": "selection",
        "symbol": "minus.circle",
        "place": "context",
        "menu": "items",
        "group": "Staging"
      },
      {
        "id": "ignore",
        "title": "Ignore",
        "description": "Adds the selected items to .gitignore.",
        "when": "selection",
        "symbol": "eye.slash",
        "place": "context",
        "menu": "items",
        "group": "Ignoring"
      },
      {
        "id": "ignore-ext",
        "title": "Ignore All Files of This Kind",
        "description": "Adds the selected items’ extensions to .gitignore.",
        "when": "selection",
        "symbol": "eye.slash",
        "place": "context",
        "menu": "items",
        "group": "Ignoring"
      },
      {
        "id": "ignore-local",
        "title": "Ignore on This Mac Only",
        "description": "Ignores the selected items here only (.git/info/exclude), never committed.",
        "when": "selection",
        "symbol": "eye.slash",
        "place": "context",
        "menu": "items",
        "group": "Ignoring"
      },
      {
        "id": "untrack",
        "title": "Stop Tracking, Keep the File",
        "description": "Takes the selected items out of git and ignores them; the files stay.",
        "when": "selection",
        "symbol": "xmark.circle",
        "place": "context",
        "menu": "items",
        "group": "Ignoring"
      },
      {
        "id": "edit-ignore",
        "title": "Edit .gitignore…",
        "description": "Opens the folder’s .gitignore to edit, with templates to insert.",
        "when": "folder",
        "symbol": "doc.text",
        "place": "context",
        "menu": "any",
        "group": "Ignoring"
      },
      {
        "id": "file-history",
        "title": "History of This File",
        "description": "The commits that touched the selected file, renames followed.",
        "when": "file",
        "symbol": "clock.arrow.circlepath",
        "place": "context",
        "menu": "items",
        "group": "History"
      },
      {
        "id": "commit",
        "title": "Commit…",
        "description": "Commits what’s staged, asking for the message.",
        "when": "folder",
        "symbol": "checkmark.circle",
        "place": "context",
        "menu": "folder",
        "group": "Repository"
      },
      {
        "id": "changes",
        "title": "Show Changes",
        "description": "Shows the diff of what changed since the last commit.",
        "when": "folder",
        "symbol": "plus.forwardslash.minus",
        "place": "context",
        "menu": "folder",
        "group": "Repository"
      },
      {
        "id": "history",
        "title": "Show History",
        "description": "Shows the last commits of the repository.",
        "when": "folder",
        "symbol": "clock",
        "place": "context",
        "menu": "folder",
        "group": "Repository"
      },
      {
        "id": "fetch",
        "title": "Fetch",
        "description": "Fetches from the configured upstream.",
        "when": "folder",
        "symbol": "arrow.down.to.line",
        "place": "context",
        "menu": "folder",
        "group": "Remote"
      },
      {
        "id": "pull",
        "title": "Pull",
        "description": "Pulls from the configured upstream.",
        "when": "folder",
        "symbol": "arrow.down",
        "place": "context",
        "menu": "folder",
        "group": "Remote"
      },
      {
        "id": "push",
        "title": "Push",
        "description": "Pushes to the configured upstream.",
        "when": "folder",
        "symbol": "arrow.up",
        "place": "context",
        "menu": "folder",
        "group": "Remote"
      },
      {
        "id": "clone",
        "title": "Clone Repository Here…",
        "description": "Clones a repository into this folder from an address you type into Chita’s own prompt.",
        "when": "folder",
        "symbol": "arrow.down.circle",
        "place": "outside",
        "menu": "folder",
        "group": "New Repository"
      },
      {
        "id": "init",
        "title": "Make a Repository Here",
        "description": "Starts a repository in this folder, on the branch main.",
        "when": "folder",
        "symbol": "plus.square",
        "place": "outside",
        "menu": "folder",
        "group": "New Repository"
      }
    ],
    "columns": [
      {
        "id": "state",
        "title": "Git"
      }
    ],
    "panels": [
      {
        "id": "repository",
        "title": "Git"
      }
    ]
  }
}
